{
  "name": "pypath-trainer",
  "version": "1.0.0",
  "private": true,
  "description": "Тренажёр по Python: теория + задачи с автопроверкой (Pyodide в браузере)",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 0.0.0.0",
